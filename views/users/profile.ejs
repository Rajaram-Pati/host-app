<% layout("/layouts/boilerplate") %>
<%
  const profileRole = currentUser.role || "user";
  const profileHostRequestStatus = currentUser.hostRequestStatus || "none";
%>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card table-card">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
              <h2 class="mb-1"><%= currentUser.username %></h2>
              <p class="text-muted mb-2"><%= currentUser.email %></p>
              <span class="badge text-bg-dark"><%= profileRole %></span>
              <span class="badge text-bg-secondary">Host request: <%= profileHostRequestStatus %></span>
            </div>

            <% if (profileRole === "user" && profileHostRequestStatus !== "pending") { %>
              <a href="/host/request" class="btn add-btn dashboard-action">Become a Host</a>
            <% } %>

            <% if (profileRole === "host") { %>
              <a href="/host/dashboard" class="btn add-btn dashboard-action">Host Dashboard</a>
            <% } %>

            <a href="/bookings/my-trips" class="btn btn-outline-secondary dashboard-action">My Trips</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
