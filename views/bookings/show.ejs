<% layout("/layouts/boilerplate") %>
<%
  const listing = booking.listing;
  const cover = listing && listing.image && listing.image.url ? listing.image.url : "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80";
  const canCancel = ["Pending", "Confirmed"].includes(booking.bookingStatus);
  const isHostUser = currentUser && booking.host && booking.host._id.equals(currentUser._id);
  const isAdminUser = currentUser && ["admin", "superAdmin"].includes(currentUser.role);
%>

<div class="container mt-4">
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card show-card">
        <img src="<%= cover %>" class="card-img-top show-img" alt="<%= listing ? listing.title : 'Booking property' %>">
        <div class="card-body">
          <h2 class="mb-2"><%= listing ? listing.title : "Deleted listing" %></h2>
          <p class="text-muted mb-0">Booking ID: <%= booking._id %></p>
          <% if (listing) { %>
            <p class="mb-0"><%= listing.location %>, <%= listing.country %></p>
          <% } %>
        </div>
      </div>

      <% if (listing && listing.additionalImages && listing.additionalImages.length) { %>
        <div class="row g-3">
          <% for (let image of listing.additionalImages) { %>
            <div class="col-md-6">
              <img src="<%= image.url %>" class="img-fluid rounded" alt="<%= listing.title %>">
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="col-lg-5">
      <div class="card table-card">
        <div class="card-body">
          <h4 class="mb-3">Reservation Details</h4>
          <div class="booking-total-box">
            <div><span>Guest</span><strong><%= booking.guest ? booking.guest.username : "-" %></strong></div>
            <div><span>Guest Email</span><strong><%= booking.guest ? booking.guest.email : "-" %></strong></div>
            <div><span>Host</span><strong><%= booking.host ? booking.host.username : "-" %></strong></div>
            <div><span>Host Email</span><strong><%= booking.host ? booking.host.email : "-" %></strong></div>
            <div><span>Phone</span><strong><%= listing && listing.contactPhone ? listing.contactPhone : "-" %></strong></div>
            <div><span>Check-in</span><strong><%= booking.checkIn.toLocaleDateString("en-IN") %></strong></div>
            <div><span>Check-out</span><strong><%= booking.checkOut.toLocaleDateString("en-IN") %></strong></div>
            <div><span>Nights</span><strong><%= booking.totalNights %></strong></div>
            <div><span>Guests</span><strong><%= booking.totalGuests %></strong></div>
            <div><span>Status</span><strong><%= booking.bookingStatus %></strong></div>
            <div><span>Payment</span><strong><%= booking.paymentStatus %></strong></div>
            <% if (booking.cancellationReason) { %>
              <div><span>Cancellation</span><strong><%= booking.cancellationReason %></strong></div>
            <% } %>
          </div>

          <h4 class="mt-4 mb-3">Price Breakdown</h4>
          <div class="booking-total-box">
            <div><span>Price per night</span><strong>&#8377; <%= Number(booking.pricePerNight || 0).toLocaleString("en-IN") %></strong></div>
            <div><span>Cleaning fee</span><strong>&#8377; <%= Number(booking.cleaningFee || 0).toLocaleString("en-IN") %></strong></div>
            <div><span>Service fee</span><strong>&#8377; <%= Number(booking.serviceFee || 0).toLocaleString("en-IN") %></strong></div>
            <div class="booking-grand-total"><span>Grand total</span><strong>&#8377; <%= Number(booking.totalPrice || 0).toLocaleString("en-IN") %></strong></div>
          </div>

          <% if (canCancel) { %>
            <form method="POST" action="/bookings/<%= booking._id %>/cancel" class="mt-3">
              <input type="text" name="cancellationReason" class="form-control mb-2" placeholder="Cancellation reason">
              <button class="btn btn-danger w-100"><%= isHostUser || isAdminUser ? "Cancel Booking" : "Cancel Booking" %></button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
